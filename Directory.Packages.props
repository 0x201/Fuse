<!-- For more info on central package management go to https://devblogs.microsoft.com/nuget/introducing-central-package-management/ -->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="ConsoleAppFramework" Version="5.7.13" />
    <PackageVersion Update="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" />
    <PackageVersion Update="Microsoft.Testing.Extensions.TrxReport" Version="2.3.3" />
    <PackageVersion Update="MSTest.TestAdapter" Version="4.3.3" />
    <PackageVersion Update="MSTest.TestFramework" Version="4.3.3" />
  </ItemGroup>
</Project>